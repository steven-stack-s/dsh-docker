# ============================================================================
# DSH Docker 部署 —— 环境变量模板
# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，密钥不会进入 git
# ============================================================================

# ★ 必填：模型 API 密钥（DSH 从环境变量读取，不落盘）
DEEPSEEK_API_KEY=sk-你的密钥

# 镜像（默认 ghcr.io；ghcr 要求小写；可改为本地构建 tag，如 dsh-base:final）
DSH_IMAGE=ghcr.io/steven-stack-s/dsh-docker:latest

# 容器名
DSH_CONTAINER_NAME=dsh

# 外部访问端口（socat 转发到容器内 dsh 的 127.0.0.1:3081）
DSH_PORT=3080

# 宿主机数据目录（相对路径基于 docker-compose.yml 所在目录；可用绝对路径）
PROGRAMS_DIR=./programs    # DSH 程序本体（npm 全局包），可容器内升级
DSH_DATA_DIR=./dsh         # DSH 用户数据（会话/配置/插件/凭据/记忆库）
WORKSPACE_DIR=./workspace  # agent 工作区

# Node 堆上限（单位 MB）。DSH 是多进程体系，实际 RSS 会显著超过此堆值（主进程+子进程+客户端 bundle），
#   故堆值必须远小于 MEM_LIMIT（建议 NODE_MAX_OLD_SPACE*1.5 估算的 RSS 仍低于 MEM_LIMIT 的一半），
#   否则 dsh 进程会被容器 OOM-kill（表现为对话/请求静默中断、FATAL ERROR）。
#   例：MEM_LIMIT=2g 时 NODE_MAX_OLD_SPACE 建议 512~1024；若调大 MEM_LIMIT，可相应上调此值。
NODE_MAX_OLD_SPACE=1024

# 资源限制（按宿主机配置调整；N100 + 8GB 示例给系统留余量）
MEM_LIMIT=2g
CPU_LIMIT=2

# 时区
TZ=Asia/Shanghai

# npm 镜像源（国内加速，可选；留空则用官方源）
NPM_REGISTRY=https://registry.npmmirror.com

# ★ /api Host 信任白名单（dsh 0.1.2 起仅信任 loopback 或白名单 Host）
#   局域网 IP 或隧道域名访问时必须填入，否则页面能开但连接异常（/api 403）。
#   逗号分隔，可带端口。示例：192.168.1.5:3080,app.xx.ugdocker.link
DSH_TRUSTED_HOSTS=

# ★ 救生舱（lifeboat）自动回退机制
#   RESCUE=1 时 docker compose up -d 进救生舱（lifeboat），RESCUE=0 恢复正常
RESCUE=0
# ★ 自动干预总闸（on=启动失败时自动归因，并按需回退快照 / 摘插件；off=绝不自动改动插件树，只诊断 + 写 incident）
#   与 RESCUE_SELFHEAL 取与：任一为 off 都只诊断不自动改（排查期间请用 off）。
#   off 时启动失败只退出，交由 restart 策略重试；救生舱(lifeboat)另由上面的 RESCUE=1 控制，
#   且当前**没有**"自动进救生舱"的降级路径（需手动 RESCUE=1，见 docs 06-救援模式 §5）。
RESCUE_AUTO=on
# 救生舱内等待 DSH 就绪的超时（秒）。口径：针对每轮 dsh 进程是否开始监听 3081；
#   该值必须 < compose healthcheck 的 start_period(默认 300s)，否则 rescue 会先于 docker 放弃
#   而误回滚仍在正常冷启动的 dsh。调大此值请同步调大 healthcheck start_period。
RESCUE_START_TIMEOUT=120
# 回退时保留的最近可用版本个数
RESCUE_KEEP=3
# 启动重试上限。默认跟随 RESCUE_KEEP（=KEEP+1）；显式设置后与快照保留数解耦。
RESCUE_MAX_ATTEMPTS=4
# 证据目录（evidence/boot-*）保留份数。默认跟随 RESCUE_KEEP。
RESCUE_EVIDENCE_KEEP=3
# 回退目标 profile（web=默认 Web 界面；可选 cli 等）
RESCUE_PROFILE=web
# ---- 自动排查·根因归因·智能自愈（rescue-diagnose）----
# 红线：自愈仅动插件树四件套 + $DSH_HOME/.rescue 状态/incident；绝不动 cordis.patch.yml / 会话 / 记忆 / 配置 / 凭据
# RESCUE_SELFHEAL: 自愈总开关(on=失败自动摘插件/回快照; off=只诊断+写incident+报告)
RESCUE_SELFHEAL=on
# 自愈预算：单容器生命周期内自动摘插件 / 回快照 的上限（超过转 report-only）
RESCUE_REMOVE_LIMIT=2
RESCUE_ROLLBACK_LIMIT=2
# 是否把每轮 dsh 启动输出 tee 捕获到 $DSH_HOME/.rescue/evidence/ 供归因
RESCUE_DIAGNOSE_EVIDENCE=on
# 单个证据文件(dsh.log)轮转上限(字节)：healthy 后活动 dsh.log 超过此值即轮转保留最近一段，防无限增长
RESCUE_EVIDENCE_MAX=20971520
# incident 保留份数（$DSH_HOME/.rescue/incidents，超出自动清理）
RESCUE_INCIDENT_KEEP=20
# 每次确认健康后是否自动拍一份"已被证明能启动"的基线快照（off=关）。
#   插件市场(dshmarket)等绕过 rescue 封装的变更靠它当回退点；基线快照同样占用 RESCUE_KEEP 份数。
#   注：此开关此前未接入 compose，通过 compose 部署时无法关闭（现已修复）。
RESCUE_SNAPSHOT_ON_HEALTHY=on
# 快照模式：hardlink=cp -al（默认；秒级、几乎不占空间，但与 live 共享 inode，任何"就地改写"
#   都可能同时污染历史快照 —— 用 `rescue verify` 检测）；copy=cp -a 独立副本（真正不可变，
#   代价是 node_modules 全量复制占磁盘）。数据紧张用 hardlink + 定期 verify，求稳用 copy。
RESCUE_SNAPSHOT_MODE=hardlink
# 自愈预算的滑动窗口（秒，默认 86400=24h）。窗口内累计的"自动摘插件/回快照"次数达到上限后转
#   report-only；窗口过期自动清零、重新获得自愈能力。（旧版本是跨重启永久累计，用满即永久失效，
#   且没有任何命令能看到或重置 —— 现可用 `rescue selfheal status|reset`。）
RESCUE_SELFHEAL_WINDOW=86400
# 自愈彻底失败（预算耗尽仍起不来）后，是否自动降级进救生舱：on=下次启动用干净最小 profile，
#   让用户至少能进界面处置（修好插件后直接 docker restart 即回到正常 profile）；off=只退出，
#   交给 restart: unless-stopped 反复重试。也可用 rescue lifeboat on|off|status 手动管理。
RESCUE_AUTO_LIFEBOAT=on
# socat 并发连接上限（fork 模式每连接一个进程）。无上限时，外部无认证的并发连接可耗尽容器内存。
SOCAT_MAX_CHILDREN=64
# 容器进程数上限
PIDS_LIMIT=512
# 模型密钥也可以放在文件里（docker secret / 挂载文件），优先级高于上面的 DEEPSEEK_API_KEY：
#   这样密钥不会出现在 docker inspect 与环境变量里。示例：
#     DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
DEEPSEEK_API_KEY_FILE=
