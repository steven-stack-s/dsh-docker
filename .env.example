# ============================================================================
# DSH Docker 部署 —— 环境变量模板
# 复制为 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，密钥不会进入 git
# ============================================================================

# ★ 必填：模型 API 密钥（DSH 从环境变量读取，不落盘）
DEEPSEEK_API_KEY=sk-你的密钥

# 镜像（默认 ghcr.io；ghcr 要求小写；可改为本地构建 tag，如 dsh-base:final）
DSH_IMAGE=ghcr.io/steven-stack-s/dsh-docker:latest

# 容器名
DSH_CONTAINER_NAME=dsh

# 外部访问端口（socat 转发到容器内 dsh 的 127.0.0.1:3081）
DSH_PORT=3080

# 宿主机数据目录（相对路径基于 docker-compose.yml 所在目录；可用绝对路径）
PROGRAMS_DIR=./programs    # DSH 程序本体（npm 全局包），可容器内升级
DSH_DATA_DIR=./dsh         # DSH 用户数据（会话/配置/插件/凭据/记忆库）
WORKSPACE_DIR=./workspace  # agent 工作区

# Node 堆上限（按宿主机内存调整，单位 MB；8GB 机器示例 1024）
NODE_MAX_OLD_SPACE=1024

# 资源限制（按宿主机配置调整）
MEM_LIMIT=2g
CPU_LIMIT=2

# 时区
TZ=Asia/Shanghai

# npm 镜像源（国内加速，可选；留空则用官方源）
NPM_REGISTRY=https://registry.npmmirror.com

# ★ /api Host 信任白名单（dsh 0.1.2 起仅信任 loopback 或白名单 Host）
#   局域网 IP 或隧道域名访问时必须填入，否则页面能开但连接异常（/api 403）。
#   逗号分隔，可带端口。示例：192.168.1.5:3080,app.xx.ugdocker.link
DSH_TRUSTED_HOSTS=

# ★ 救生舱（lifeboat）自动回退机制
#   RESCUE=1 时 docker compose up -d 进救生舱（lifeboat），RESCUE=0 恢复正常
RESCUE=0
# 启动失败时是否自动回退（on=探测超时自动回退到最近可用快照；off=不回退，退出交由 restart 策略重试，非救生舱）
#   救生舱(lifeboat)由上面的 RESCUE=1 单独控制，与 RESCUE_AUTO 无关
RESCUE_AUTO=on
# 救生舱内等待 DSH 就绪的超时（秒）
RESCUE_START_TIMEOUT=120
# 回退时保留的最近可用版本个数
RESCUE_KEEP=3
# 回退目标 profile（web=默认 Web 界面；可选 cli 等）
RESCUE_PROFILE=web
# ---- 自动排查·根因归因·智能自愈（rescue-diagnose）----
# 红线：自愈仅动插件树四件套 + $DSH_HOME/.rescue 状态/incident；绝不动 cordis.patch.yml / 会话 / 记忆 / 配置 / 凭据
# RESCUE_SELFHEAL: 自愈总开关(on=失败自动摘插件/回快照; off=只诊断+写incident+报告)
RESCUE_SELFHEAL=on
# 自愈预算：单容器生命周期内自动摘插件 / 回快照 的上限（超过转 report-only）
RESCUE_REMOVE_LIMIT=2
RESCUE_ROLLBACK_LIMIT=2
# 是否把每轮 dsh 启动输出 tee 捕获到 $DSH_HOME/.rescue/evidence/ 供归因
RESCUE_DIAGNOSE_EVIDENCE=on
# incident 保留份数（$DSH_HOME/.rescue/incidents，超出自动清理）
RESCUE_INCIDENT_KEEP=20
